# Copy to .env, then fill every empty value. Keep .env untracked.
# Database passwords must be URL-safe: use random hexadecimal strings.
ANALYTICS_DB_NAME=github_issues
ANALYTICS_DB_USER=analytics
ANALYTICS_DB_PASSWORD=
ANALYTICS_DB_PORT=5433

AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=
AIRFLOW_PORT=8080

METABASE_DB_NAME=metabaseapp
METABASE_DB_USER=metabase
METABASE_DB_PASSWORD=
METABASE_PORT=3000
METABASE_ADMIN_EMAIL=
METABASE_ADMIN_PASSWORD=

# PostgreSQL login used by Metabase for the analytics source, CDM only.
CDM_READ_PASSWORD=

# GitHub access is needed only for STG loads, not for starting Compose.
GITHUB_TOKEN=
GITHUB_CREATED_SINCE=2023-01-01T00:00:00Z
